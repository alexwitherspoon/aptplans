{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptplans.org/schema/oregon-benchmark-manifest-v1.json",
  "title": "AptPlans Oregon benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "frozen_at",
    "state",
    "scope",
    "network_policy",
    "model_policy",
    "repeat_clean_runs",
    "reference_inputs",
    "airports",
    "artifacts",
    "official_source_expectations",
    "funding_expectations",
    "required_modalities",
    "claims",
    "known_gaps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date"},
    "state": {"const": "OR"},
    "scope": {"type": "string", "minLength": 1},
    "network_policy": {"const": "forbidden"},
    "model_policy": {"const": "forbidden"},
    "repeat_clean_runs": {"type": "integer", "minimum": 2},
    "reference_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "airports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "official_source_expectations": {
      "$ref": "#/$defs/officialSourceExpectations"
    },
    "funding_expectations": {"type": "object"},
    "required_modalities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "covered",
          "covered_full_only",
          "missing",
          "normalized_fixture_only",
          "source_fixture_only"
        ]
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_2_clean_cutover_rerun",
        "oregon_complete",
        "milestone_4_oregon_vertical_proof",
        "milestone_5_statewide_expansion",
        "milestone_6_completion_contract"
      ],
      "properties": {
        "milestone_2_clean_cutover_rerun": {"const": "passed"},
        "oregon_complete": {"const": false},
        "milestone_4_oregon_vertical_proof": {"const": "blocked"},
        "milestone_5_statewide_expansion": {"const": "blocked"},
        "milestone_6_completion_contract": {"const": "blocked"}
      }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "minimum_characters",
        "required_phrases"
      ],
      "properties": {
        "pages": {"type": "integer", "minimum": 1},
        "minimum_characters": {"type": "integer", "minimum": 1},
        "required_phrases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "path",
        "sha256",
        "bytes",
        "modality"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "modality": {"type": "string", "minLength": 1},
        "extract": {"$ref": "#/$defs/extraction"},
        "extract_full_only": {"$ref": "#/$defs/extraction"}
      },
      "oneOf": [
        {"required": ["extract"]},
        {"required": ["extract_full_only"]}
      ]
    },
    "officialSourceExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faa_grant_workbook",
        "odav_budget_pdf",
        "historical_plan_scan",
        "brookings_airport_budget"
      ],
      "properties": {
        "faa_grant_workbook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "fiscal_year",
            "total_grant_rows",
            "airport_lid",
            "airport_grant_count",
            "airport_award_total"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "fiscal_year": {"type": "integer", "minimum": 1982},
            "total_grant_rows": {"type": "integer", "minimum": 1},
            "airport_lid": {"type": "string", "minLength": 2},
            "airport_grant_count": {"type": "integer", "minimum": 1},
            "airport_award_total": {"type": "integer", "minimum": 1}
          }
        },
        "odav_budget_pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "extract_full_only"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "extract_full_only": {"$ref": "#/$defs/extraction"}
          }
        },
        "historical_plan_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source_record_url",
            "text_layer",
            "extract_full_only"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "source_record_url": {"type": "string", "format": "uri"},
            "text_layer": {"const": "embedded_ocr"},
            "extract_full_only": {"$ref": "#/$defs/extraction"}
          }
        },
        "brookings_airport_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source_url",
            "fiscal_year",
            "document_pages",
            "airport_narrative_page",
            "airport_image_only_pages",
            "minimum_full_page_image_pixels",
            "producer_contains"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "source_url": {"type": "string", "format": "uri"},
            "fiscal_year": {"const": "2025-26"},
            "document_pages": {"type": "integer", "minimum": 1},
            "airport_narrative_page": {"type": "integer", "minimum": 1},
            "airport_image_only_pages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "minimum_full_page_image_pixels": {
              "type": "integer",
              "minimum": 1000000
            },
            "producer_contains": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
