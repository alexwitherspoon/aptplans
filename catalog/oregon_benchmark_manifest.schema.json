{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptplans.org/schema/oregon-benchmark-manifest-v1.json",
  "title": "AptPlans Oregon benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "frozen_at",
    "state",
    "scope",
    "network_policy",
    "model_policy",
    "repeat_clean_runs",
    "reference_inputs",
    "airports",
    "artifacts",
    "funding_expectations",
    "required_modalities",
    "claims",
    "known_gaps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date"},
    "state": {"const": "OR"},
    "scope": {"type": "string", "minLength": 1},
    "network_policy": {"const": "forbidden"},
    "model_policy": {"const": "forbidden"},
    "repeat_clean_runs": {"type": "integer", "minimum": 2},
    "reference_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "airports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "funding_expectations": {"type": "object"},
    "required_modalities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "covered",
          "covered_full_only",
          "missing",
          "normalized_fixture_only"
        ]
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_2_clean_cutover_rerun",
        "oregon_complete",
        "milestone_4_oregon_vertical_proof",
        "milestone_5_statewide_expansion",
        "milestone_6_completion_contract"
      ],
      "properties": {
        "milestone_2_clean_cutover_rerun": {"const": "passed"},
        "oregon_complete": {"const": false},
        "milestone_4_oregon_vertical_proof": {"const": "blocked"},
        "milestone_5_statewide_expansion": {"const": "blocked"},
        "milestone_6_completion_contract": {"const": "blocked"}
      }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "minimum_characters",
        "required_phrases"
      ],
      "properties": {
        "pages": {"type": "integer", "minimum": 1},
        "minimum_characters": {"type": "integer", "minimum": 1},
        "required_phrases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "path",
        "sha256",
        "bytes",
        "modality"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "modality": {"type": "string", "minLength": 1},
        "extract": {"$ref": "#/$defs/extraction"},
        "extract_full_only": {"$ref": "#/$defs/extraction"}
      },
      "oneOf": [
        {"required": ["extract"]},
        {"required": ["extract_full_only"]}
      ]
    }
  }
}
