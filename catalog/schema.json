{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptplans.org/schema/document.json",
  "title": "AptPlans document",
  "description": "An airport master plan, Airport Layout Plan (ALP), statute citation, notice citation, or related record. A document is complete only when both the official URL and a preserved copy exist. Notices are citation-only (publisher, published date, URL).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "source_url",
    "completeness"
  ],
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["master_plan", "alp", "statute", "sasp", "notice", "other"]
    },
    "airport_lid": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "edition": { "type": ["string", "null"] },
    "source_url": { "type": "string", "format": "uri" },
    "source_retrieved_at": { "type": ["string", "null"] },
    "source_status": {
      "type": "string",
      "enum": ["live", "moved", "dead", "replaced", "unknown"]
    },
    "content_sha256": { "type": ["string", "null"] },
    "text_sha256": { "type": ["string", "null"] },
    "images_sha256": { "type": ["string", "null"] },
    "preserved_url": { "type": ["string", "null"] },
    "ia_item": { "type": ["string", "null"] },
    "mirrors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "license_or_rights": {
      "type": "string",
      "enum": ["public_record", "government_edict", "unknown", "takedown"]
    },
    "supersedes": { "type": ["string", "null"] },
    "review_status": {
      "type": "string",
      "enum": ["pending", "auto_pass", "needs_human", "published"]
    },
    "completeness": {
      "type": "string",
      "enum": ["complete", "link_only", "preserved_only", "missing", "no_plan_known"]
    },
    "summary": { "type": ["string", "null"] },
    "publisher": { "type": ["string", "null"] },
    "published_at": { "type": ["string", "null"] },
    "found_on": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Page that listed this file. Provenance of discovery, not a second official source."
    },
    "part_of": {
      "type": ["string", "null"],
      "description": "Document id of the edition this chapter or section update belongs to."
    },
    "media": {
      "type": ["string", "null"],
      "enum": ["pdf", "html", "other", null],
      "description": "What we hashed. A webpage can be complete without a PDF."
    }
  }
}
