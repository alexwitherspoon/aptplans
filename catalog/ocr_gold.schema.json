{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptplans.org/schema/ocr-gold-v1.json",
  "title": "AptPlans OCR gold assertions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "source_path",
    "source_sha256",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "assertions"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "text"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "sequence"},
            "text": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "terms"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "all_of"},
            "terms": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "anchor",
            "terms",
            "max_characters"
          ],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "window"},
            "anchor": {"type": "string", "minLength": 1},
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "max_characters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      ]
    }
  }
}
