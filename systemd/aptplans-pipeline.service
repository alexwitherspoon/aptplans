[Unit]
Description=AptPlans serial document pipeline
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aptplans
EnvironmentFile=-/home/aptplans/.env.production
ExecStart=/usr/bin/docker compose --env-file /home/aptplans/.env.production -f docker/docker-compose.yml -f docker/docker-compose.prod.yml --profile jobs run --rm --no-deps pipeline
Nice=10
