[Unit]
Description=AptPlans serial document pipeline
After=docker.service network-online.target
Requires=docker.service
# Worker must already be up from CD (`compose up`).

[Service]
Type=oneshot
WorkingDirectory=/opt/aptplans
EnvironmentFile=-/home/aptplans/.env.production
ExecStart=/usr/bin/docker compose --env-file /home/aptplans/.env.production -f docker/docker-compose.yml -f docker/docker-compose.prod.yml exec -T worker python3 pipeline/run_once.py
Nice=10
