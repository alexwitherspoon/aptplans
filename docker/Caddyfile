(static) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle_path /files/* {
		root * /srv/files
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * /srv/site
		header Cache-Control "no-store"
		file_server
	}
}

(search_query) {
	@search_post {
		path /search/query
		method POST
	}
	handle @search_post {
		header Cache-Control "no-store"
		request_body {
			max_size 8KB
		}
		rewrite * /indexes/aptplans/search
		reverse_proxy search:7700 {
			header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			header_up Content-Type application/json
			transport http {
				dial_timeout 1s
				response_header_timeout 3s
			}
		}
	}
}

:80 {
	import search_query
	import static
}
