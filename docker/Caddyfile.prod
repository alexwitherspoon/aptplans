(static) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@search_post {
		path /search/query
		method POST
	}
	handle @search_post {
		request_body {
			max_size 8KB
		}
		rewrite * /indexes/aptplans/search
		reverse_proxy search:7700 {
			header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			header_up Content-Type application/json
			transport http {
				dial_timeout 1s
				response_header_timeout 3s
			}
		}
	}

	handle {
		root * /srv/site
		file_server
	}
}

:80 {
	import static
}

:443 {
	tls /certs/origin.pem /certs/origin.key
	import static
}
