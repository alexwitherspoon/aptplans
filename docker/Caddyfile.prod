(static) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@search_post {
		path /search/query
		method POST
	}
	handle @search_post {
		header Cache-Control "no-store"
		request_body {
			max_size 8KB
		}
		rewrite * /indexes/aptplans/search
		reverse_proxy search:7700 {
			header_up Authorization "Bearer {$MEILI_MASTER_KEY}"
			header_up Content-Type application/json
			transport http {
				dial_timeout 1s
				response_header_timeout 3s
			}
		}
	}

	handle {
		root * /srv/site
		header Cache-Control "public, max-age=86400"
		file_server
	}
}

# Token API for agents and laptops. TLS on :443 only. App still checks the key.
# Health is the only unauthenticated path. Cloudflare must not cache this prefix.
(review) {
	handle_path /review/* {
		header {
			Cache-Control "no-store, private"
			X-Robots-Tag "noindex, nofollow"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		request_body {
			max_size 64KB
		}
		@review_health {
			path /v1/health
			method GET
		}
		handle @review_health {
			reverse_proxy review:8787
		}
		@review_key {
			header X-Api-Key *
		}
		@review_bearer {
			header Authorization Bearer*
		}
		handle @review_key {
			reverse_proxy review:8787 {
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle @review_bearer {
			reverse_proxy review:8787 {
				transport http {
					response_header_timeout 120s
				}
			}
		}
		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized"}` 401
		}
	}
}

:80 {
	import static
}

:443 {
	tls /certs/origin.pem /certs/origin.key
	import review
	import static
}
