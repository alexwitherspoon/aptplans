(static) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}

:80 {
	import static
}

:443 {
	tls /certs/origin.pem /certs/origin.key
	import static
}
