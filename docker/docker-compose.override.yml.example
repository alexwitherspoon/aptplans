# Copy to docker-compose.override.yml and adjust host paths.
# docker-compose.override.yml is gitignored.

services:
  site:
    volumes:
      - /var/lib/aptplans/site:/srv/site:ro
      - /var/lib/aptplans/public-files:/srv/files:ro

  worker:
    volumes:
      - /opt/aptplans:/app
      - /var/lib/aptplans/files:/var/lib/aptplans/files
      - /var/lib/aptplans/public-files:/var/lib/aptplans/public-files
      - /var/lib/aptplans/queue:/var/lib/aptplans/queue
      - /var/lib/aptplans/catalog:/var/lib/aptplans/catalog
      - /var/lib/aptplans/text:/var/lib/aptplans/text
      - /var/lib/aptplans/reject:/var/lib/aptplans/reject

  search:
    volumes:
      - /var/lib/aptplans/search:/meili_data
