# Copy to .env in this directory (gitignored). Never commit the copy.
# Origin CD uses GitHub Actions secrets, not this file.
# Do not use .env.search — that name is the origin Meilisearch master key.

# Review API (same value as GitHub secret APTPLANS_REVIEW_TOKEN)
# Origin: https://aptplans.org/review  Local stack: http://127.0.0.1:8787
APTPLANS_REVIEW_TOKEN=
APTPLANS_REVIEW_URL=https://aptplans.org/review

# Brave Search (same value as GitHub secret APTPLANS_SEARCH_KEY)
APTPLANS_SEARCH_KEY=
APTPLANS_SEARCH_PROVIDER=brave

# Optional Gemini escalate (same value as GitHub secret APTPLANS_GEMINI_KEY)
APTPLANS_GEMINI_KEY=
