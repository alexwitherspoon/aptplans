# Copy to .env in this directory (gitignored). Never commit the copy.
# Origin CD uses GitHub Actions secrets, not this file.
# Do not use .env.search — that name is the origin Meilisearch master key.

# Review API (same value as GitHub secret APTPLANS_REVIEW_TOKEN)
# Origin: https://aptplans.org/review  Local stack: http://127.0.0.1:8787
APTPLANS_REVIEW_TOKEN=
APTPLANS_REVIEW_URL=https://aptplans.org/review

# Brave Search (origin .env.secrets; required on production)
APTPLANS_SEARCH_KEY=
APTPLANS_SEARCH_PROVIDER=brave
# Local live search opt-in (production uses APP_ENV=production instead)
# APTPLANS_LIVE_SEARCH=1

# Optional Gemini escalate (same value as GitHub secret APTPLANS_GEMINI_KEY)
APTPLANS_GEMINI_KEY=

# Worker tempo (origin defaults: 1 airport, 2s pause between jobs)
# APTPLANS_AIRPORT_CONCURRENCY=1
# APTPLANS_JOB_PAUSE_SEC=2

# Metered search budgets (local ledger in overlay search_meter.json)
# APTPLANS_BRAVE_MONTHLY_BUDGET_USD=25
# APTPLANS_BRAVE_MONTHLY_CREDIT_USD=5
# APTPLANS_BRAVE_USD_PER_1K=5
# APTPLANS_SEARCH_MONTHLY_CAP=
# APTPLANS_GEMINI_MONTHLY_BUDGET_USD=25
# APTPLANS_GEMINI_USD_PER_1K=14
# APTPLANS_GEMINI_FREE_PROMPTS=5000
# APTPLANS_GEMINI_QUERIES_PER_PROMPT=4
# APTPLANS_GEMINI_MONTHLY_CAP=

# Optional reserve and max sleep when local budget is spent (seconds)
# APTPLANS_SEARCH_BUDGET_RESERVE=0
# APTPLANS_SEARCH_BUDGET_WAIT_MAX_SEC=3600

# Discovery (worker also polls daily while idle; systemd timer is backup)
# APTPLANS_DISCOVERY_LIMIT=5
# APTPLANS_DISCOVERY_MAX_STEPS=5
# APTPLANS_DISCOVERY_IDLE_SEC=86400
# APTPLANS_DISCOVERY_FUNDED_FIRST=1
# APTPLANS_DISCOVERY_FEDERAL_FIRST=1
# APTPLANS_DISCOVERY_RECENCY_DAYS=30

# PIA VPN for local egress testing (docker-compose.egress-local.yml / make stack-egress).
# Use the p... VPN login, not the SOCKS x... user. Same values as GitHub secrets
# PIA_OPENVPN_USER, PIA_OPENVPN_PASSWORD, and optional PIA_SERVER_REGIONS.
PIA_OPENVPN_USER=
PIA_OPENVPN_PASSWORD=
PIA_SERVER_REGIONS=US East
